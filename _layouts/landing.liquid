<!doctype html>
<html lang="{{ site.lang }}">
  <head>
    {% include metadata.liquid %}
    <meta http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: https:; font-src 'self' data: https:; media-src 'self' https:; frame-src 'self' https:; connect-src 'self' https:;">
    <link rel="stylesheet" href="{{ '/assets/css/bootstrap.min.css' | relative_url | bust_file_cache }}">
    <link rel="stylesheet"
      href="{{ site.third_party_libraries.mdb.url.css }}"
      integrity="{{ site.third_party_libraries.mdb.integrity.css }}"
      crossorigin="anonymous">
    <link defer rel="stylesheet" href="{{ '/assets/css/main.css' | relative_url | bust_file_cache }}">
    <style>
      /* =============================================
         LANDING PAGE — BRIGHT OCEAN THEME
         ============================================= */
      :root {
        --ocean-dark:   #0096C7;
        --ocean-mid:    #48CAE4;
        --ocean-light:  #ADE8F4;
        --ocean-foam:   #CAF0F8;
        --ocean-deep:   #023E8A;
        --jf-color:     #06D6A0;
        --jf-dark:      #028A6E;
        --bbq-color:    #FF9F1C;
        --bbq-dark:     #C47800;
        --text-dark:    #023E8A;
        --text-light:   #ffffff;
        --card-shadow:  0 20px 60px rgba(0, 150, 199, 0.18);
        --card-hover:   0 32px 80px rgba(0, 150, 199, 0.30);
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }

      html, body {
        height: 100%;
        font-family: 'Roboto', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        overflow-x: hidden;
      }

      /* ---- OCEAN GRADIENT BACKGROUND ---- */
      .landing-page {
        min-height: 100vh;
        background: linear-gradient(
          180deg,
          #f0f9ff 0%,
          #e0f4fd 30%,
          #ADE8F4 65%,
          #0096C7 100%
        );
        position: relative;
      }

      /* ---- FLOATING BUBBLES ---- */
      .bubbles {
        position: fixed;
        top: 0; left: 0;
        width: 100%; height: 100%;
        pointer-events: none;
        z-index: 0;
        overflow: hidden;
      }

      .bubble {
        position: absolute;
        bottom: -100px;
        border-radius: 50%;
        background: rgba(255,255,255,0.25);
        animation: rise linear infinite;
      }

      @keyframes rise {
        0%   { bottom: -100px; opacity: 0; transform: scale(0.5); }
        10%  { opacity: 1; }
        90%  { opacity: 0.6; }
        100% { bottom: 110vh; opacity: 0; transform: scale(1.1); }
      }

      /* ---- HERO SECTION ---- */
      .hero {
        position: relative;
        z-index: 10;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        padding: 60px 20px 80px;
        text-align: center;
      }

      .mola-emoji {
        font-size: 5rem;
        animation: float 4s ease-in-out infinite;
        display: block;
        margin-bottom: 16px;
        filter: drop-shadow(0 8px 20px rgba(0,150,199,0.3));
      }

      @keyframes float {
        0%, 100% { transform: translateY(0px) rotate(-3deg); }
        50%       { transform: translateY(-18px) rotate(3deg); }
      }

      .site-title {
        font-size: clamp(2.8rem, 8vw, 5rem);
        font-weight: 900;
        color: var(--ocean-deep);
        letter-spacing: -1px;
        line-height: 1;
        margin-bottom: 12px;
        text-shadow: 0 2px 20px rgba(2,62,138,0.12);
      }

      .site-title .wave-text {
        background: linear-gradient(135deg, var(--ocean-dark), var(--ocean-mid));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .site-subtitle {
        font-size: clamp(1rem, 2.5vw, 1.3rem);
        color: #0077A8;
        margin-bottom: 60px;
        font-weight: 300;
        letter-spacing: 0.5px;
        max-width: 500px;
      }

      /* ---- ENTRY CARDS ---- */
      .entry-cards {
        display: flex;
        gap: 32px;
        justify-content: center;
        align-items: stretch;
        flex-wrap: wrap;
        margin-bottom: 60px;
        width: 100%;
        max-width: 860px;
      }

      .entry-card {
        flex: 1 1 340px;
        max-width: 400px;
        background: rgba(255,255,255,0.92);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-radius: 24px;
        padding: 44px 36px;
        text-decoration: none;
        color: inherit;
        box-shadow: var(--card-shadow);
        border: 2px solid rgba(255,255,255,0.6);
        transition: all 0.35s cubic-bezier(0.23, 1, 0.32, 1);
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
      }

      .entry-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 5px;
        border-radius: 24px 24px 0 0;
        transition: height 0.35s ease;
      }

      .entry-card.jf::before  { background: linear-gradient(90deg, var(--jf-color), #02C9A0); }
      .entry-card.bbq::before { background: linear-gradient(90deg, var(--bbq-color), #FF6B35); }

      .entry-card:hover {
        transform: translateY(-12px) scale(1.02);
        box-shadow: var(--card-hover);
        border-color: rgba(255,255,255,0.9);
        text-decoration: none;
        color: inherit;
      }

      .entry-card:hover::before { height: 8px; }

      .card-emoji {
        font-size: 3rem;
        margin-bottom: 16px;
        display: block;
        transition: transform 0.35s ease;
      }

      .entry-card:hover .card-emoji { transform: scale(1.2) rotate(10deg); }

      .card-handle {
        font-size: 1.6rem;
        font-weight: 800;
        color: var(--ocean-deep);
        margin-bottom: 8px;
        letter-spacing: -0.5px;
      }

      .entry-card.jf  .card-handle { color: var(--jf-dark); }
      .entry-card.bbq .card-handle { color: var(--bbq-dark); }

      .card-tagline {
        font-size: 0.95rem;
        color: #5a7a8a;
        margin-bottom: 20px;
        font-style: italic;
        flex: 1;
      }

      .card-links {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: auto;
      }

      .card-link-pill {
        display: inline-flex;
        align-items: center;
        padding: 4px 14px;
        border-radius: 20px;
        font-size: 0.78rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
        border: 1.5px solid;
      }

      .entry-card.jf  .card-link-pill {
        color: var(--jf-dark);
        border-color: var(--jf-color);
        background: rgba(6, 214, 160, 0.08);
      }
      .entry-card.bbq .card-link-pill {
        color: var(--bbq-dark);
        border-color: var(--bbq-color);
        background: rgba(255, 159, 28, 0.08);
      }

      .card-link-pill:hover {
        text-decoration: none;
        background: rgba(6,214,160,0.18);
        transform: scale(1.05);
      }

      .entry-card.bbq .card-link-pill:hover {
        background: rgba(255,159,28,0.18);
      }

      .card-enter-arrow {
        position: absolute;
        bottom: 20px;
        right: 24px;
        font-size: 1.4rem;
        opacity: 0;
        transform: translateX(-8px);
        transition: all 0.3s ease;
      }

      .entry-card:hover .card-enter-arrow {
        opacity: 1;
        transform: translateX(0);
      }

      /* ---- SHARED SECTION ---- */
      .shared-section {
        position: relative;
        z-index: 10;
        background: rgba(255,255,255,0.15);
        backdrop-filter: blur(10px);
        border-top: 1px solid rgba(255,255,255,0.4);
        padding: 48px 20px;
        text-align: center;
      }

      .shared-label {
        font-size: 0.85rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 3px;
        color: rgba(255,255,255,0.75);
        margin-bottom: 20px;
      }

      .shared-title {
        font-size: 1.7rem;
        font-weight: 800;
        color: #ffffff;
        margin-bottom: 8px;
        text-shadow: 0 2px 12px rgba(0,0,0,0.15);
      }

      .shared-desc {
        font-size: 1rem;
        color: rgba(255,255,255,0.8);
        margin-bottom: 32px;
        max-width: 500px;
        margin-left: auto;
        margin-right: auto;
      }

      .shared-cards {
        display: flex;
        gap: 20px;
        justify-content: center;
        flex-wrap: wrap;
        max-width: 700px;
        margin: 0 auto;
      }

      .shared-card {
        flex: 1 1 260px;
        max-width: 320px;
        background: rgba(255,255,255,0.18);
        border: 1.5px solid rgba(255,255,255,0.45);
        border-radius: 18px;
        padding: 28px 28px;
        text-decoration: none;
        color: #ffffff;
        transition: all 0.3s ease;
        text-align: left;
        backdrop-filter: blur(8px);
      }

      .shared-card:hover {
        background: rgba(255,255,255,0.28);
        transform: translateY(-6px);
        color: #ffffff;
        text-decoration: none;
        box-shadow: 0 16px 40px rgba(0,0,0,0.15);
      }

      .shared-card-icon { font-size: 2rem; margin-bottom: 12px; display: block; }
      .shared-card-title { font-size: 1.15rem; font-weight: 700; margin-bottom: 6px; }
      .shared-card-desc  { font-size: 0.87rem; opacity: 0.82; line-height: 1.5; }

      /* ---- WAVES ---- */
      .wave-divider {
        position: relative;
        z-index: 5;
        line-height: 0;
        overflow: hidden;
      }

      .wave-divider svg {
        display: block;
        width: 100%;
        min-width: 600px;
      }

      /* ---- FOOTER ---- */
      .landing-footer {
        background: #023E8A;
        color: rgba(255,255,255,0.55);
        text-align: center;
        padding: 20px;
        font-size: 0.8rem;
        position: relative;
        z-index: 10;
      }

      .landing-footer a { color: var(--ocean-mid); text-decoration: none; }
      .landing-footer a:hover { color: var(--ocean-light); }

      /* ---- RESPONSIVE ---- */
      @media (max-width: 640px) {
        .entry-card { padding: 32px 24px; }
        .hero { padding: 40px 16px 60px; }
      }
    </style>
  </head>

  <body>
    <div class="landing-page">

      <!-- Floating Bubbles -->
      <div class="bubbles" aria-hidden="true">
        <div class="bubble" style="left:8%;  width:18px; height:18px; animation-duration:9s;  animation-delay:0s;"></div>
        <div class="bubble" style="left:18%; width:10px; height:10px; animation-duration:12s; animation-delay:1.5s;"></div>
        <div class="bubble" style="left:30%; width:24px; height:24px; animation-duration:8s;  animation-delay:0.8s;"></div>
        <div class="bubble" style="left:45%; width:14px; height:14px; animation-duration:11s; animation-delay:2.5s;"></div>
        <div class="bubble" style="left:58%; width:20px; height:20px; animation-duration:10s; animation-delay:0.3s;"></div>
        <div class="bubble" style="left:70%; width:12px; height:12px; animation-duration:13s; animation-delay:1.8s;"></div>
        <div class="bubble" style="left:82%; width:16px; height:16px; animation-duration:9s;  animation-delay:3.2s;"></div>
        <div class="bubble" style="left:92%; width:22px; height:22px; animation-duration:11s; animation-delay:0.5s;"></div>
      </div>

      <!-- Hero -->
      <div class="hero">
        <span class="mola-emoji" aria-hidden="true">🐟</span>
        <h1 class="site-title">
          <span class="wave-text">Mola</span> Mola
        </h1>
        <p class="site-subtitle">
          Two fish in a big ocean &mdash; hacking, building &amp; sharing.
        </p>

        <!-- Entry Cards -->
        <div class="entry-cards">

          <!-- JuicyForgJF Card -->
          <a class="entry-card jf" href="{{ '/jf/' | relative_url }}">
            <span class="card-emoji">🐟</span>
            <div class="card-handle">JuicyForgJF</div>
            <div class="card-tagline">hack the planet &mdash; security research &amp; dev</div>
            <div class="card-links">
              <span class="card-link-pill">About</span>
              <span class="card-link-pill">CV</span>
              <span class="card-link-pill">Projects</span>
              <span class="card-link-pill">Blog</span>
            </div>
            <span class="card-enter-arrow">→</span>
          </a>

          <!-- AmazonBBQ Card -->
          <a class="entry-card bbq" href="{{ '/bbq/' | relative_url }}">
            <span class="card-emoji">🔥</span>
            <div class="card-handle">AmazonBBQ</div>
            <div class="card-tagline">always grilling &mdash; security &amp; CTF</div>
            <div class="card-links">
              <span class="card-link-pill">About</span>
              <span class="card-link-pill">CV</span>
              <span class="card-link-pill">Projects</span>
              <span class="card-link-pill">Blog</span>
            </div>
            <span class="card-enter-arrow">→</span>
          </a>

        </div>

        <!-- Scroll hint -->
        <p style="color: #0077A8; font-size:0.85rem; animation: fade-in-out 3s ease-in-out infinite;">
          ↓ &nbsp; shared adventures below
        </p>
        <style>
          @keyframes fade-in-out {
            0%,100% { opacity:0.4; } 50% { opacity:1; }
          }
        </style>
      </div>

      <!-- Wave Divider -->
      <div class="wave-divider">
        <svg viewBox="0 0 1440 80" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M0,40 C180,80 360,0 540,40 C720,80 900,0 1080,40 C1260,80 1380,20 1440,40 L1440,80 L0,80 Z"
            fill="rgba(0,150,199,0.45)" />
          <path d="M0,55 C200,20 400,70 600,45 C800,20 1000,65 1200,45 C1320,32 1390,50 1440,55 L1440,80 L0,80 Z"
            fill="rgba(0,100,160,0.35)" />
        </svg>
      </div>

      <!-- Shared Section -->
      <div class="shared-section">
        <p class="shared-label">🤝 Together</p>
        <h2 class="shared-title">Shared Adventures</h2>
        <p class="shared-desc">When two fish team up — joint CTF writeups and collaborative projects.</p>

        <div class="shared-cards">
          <a class="shared-card" href="{{ '/ctf/' | relative_url }}">
            <span class="shared-card-icon">🏴</span>
            <div class="shared-card-title">CTF Writeups</div>
            <div class="shared-card-desc">Competition solutions, techniques, and notes from our CTF adventures together.</div>
          </a>
          <a class="shared-card" href="{{ '/collab/' | relative_url }}">
            <span class="shared-card-icon">🛠️</span>
            <div class="shared-card-title">Collab Projects</div>
            <div class="shared-card-desc">Tools, research, and experiments we built together in the deep ocean of code.</div>
          </a>
        </div>
      </div>

      <!-- Landing Footer -->
      <div class="landing-footer">
        &copy; {{ site.time | date: '%Y' }} JuicyForgJF &amp; AmazonBBQ &mdash;
        Powered by <a href="https://jekyllrb.com/" target="_blank">Jekyll</a> +
        <a href="https://github.com/alshedivat/al-folio" target="_blank">al-folio</a>
      </div>

    </div><!-- /.landing-page -->
  </body>
</html>
